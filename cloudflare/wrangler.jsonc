{
  "name": "think-tank-council-preview",
  "main": "./src/index.mjs",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "think-tank",
      "database_id": "24672c6e-2d4c-4ffb-8e87-bb391d1d5830",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "jussray.cloudflareaccess.com",
    "ACCESS_AUD": "23a4f44b94fef56ec7562da17b5d77d1e4d5f9467f0624349ce84e69bfdc40cd"
  }
}
