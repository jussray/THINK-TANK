{
  "name": "think-tank",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "npm run build:static && npm run check:runtime-manifest",
    "serve": "http-server . -p 4173 -c-1",
    "serve:artifact": "http-server _site -p 4174 -c-1",
    "build:static": "node scripts/build-static-artifact.mjs",
    "check:runtime-manifest": "node scripts/check-runtime-manifest.mjs",
    "check:storage-boundary": "node scripts/check-storage-boundary.mjs",
    "check:domain-purity": "node scripts/check-domain-purity.mjs",
    "test:unit": "node --test tests/stores/*.test.js tests/domain/*.test.js tests/policy/*.test.js tests/contracts/*.test.js tests/scripts/*.test.js revival/ai/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:artifact": "playwright test -c playwright.artifact.config.js",
    "test:e2e:file": "playwright test -c playwright.file.config.js"
  },
  "devDependencies": {
    "wrangler": "4.149.0",
    "@playwright/test": "1.55.0",
    "http-server": "14.1.1"
  }
}
