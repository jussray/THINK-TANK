{
  "name": "think-tank",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./_site"
  },
  "previews": {},

  // Cloudflare already has a proxied CNAME for this host AND this Worker Route.
  // A custom_domain tries to create a second DNS record and fails with 100117.
  // Mirror the EXISTING route verbatim; do not delete or replace the DNS record.
  // Route or DNS ownership changes require a separate founder-controlled gate.
  "routes": [
    {
      "pattern": "*thinktank.jussco.company/*",
      "zone_name": "jussco.company"
    }
  ],

  // Version/Preview URLs off. A preview build of any branch would otherwise get
  // a public *.workers.dev URL that serves an unapproved artifact under the
  // product's name, with nothing stating which commit it came from.
  // (Wrangler still calls this field `preview_urls`.)
  "preview_urls": false
}
