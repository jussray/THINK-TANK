{
  "name": "think-tank",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./_site"
  },
  "previews": {},

  // Origin Worker for the public product. Since 2026-10-28 the public
  // front door (think-tank-public-front-door) serves this Worker's exact
  // artifact at thinktank.jussco.company through an internal service
  // binding; the founder ruling of 2026-10-25 settled that the whole
  // artifact is public product surface. This Worker stays Access-
  // protected on its own hostname, and no public link or redirect sends
  // users there.
  //
  // IMPORTANT: Never attach this Worker as a Custom Domain to either public
  // hostname: doing so would overwrite the public entrance on the next deploy.
  "routes": [
    {
      "pattern": "thinktank-app.jussco.company/*",
      "zone_name": "jussco.company"
    }
  ],

  // Version/Preview URLs off. A preview build of any branch would otherwise get
  // a public *.workers.dev URL that serves an unapproved artifact under the
  // product's name, with nothing stating which commit it came from.
  // (Wrangler still calls this field `preview_urls`.)
  "preview_urls": false
}
