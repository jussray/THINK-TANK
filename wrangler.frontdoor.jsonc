{
  "name": "think-tank-public-front-door",
  "main": "worker/frontdoor.mjs",
  "compatibility_date": "2026-10-16",
  "services": [
    {
      "binding": "APP",
      "service": "think-tank",
      "environment": "production"
    }
  ],
  "preview_urls": false,
  "workers_dev": false,
  "ratelimits": [
    {
      "name": "AI_RATE_LIMIT",
      "namespace_id": "20261125",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
