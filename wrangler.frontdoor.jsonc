{
  "name": "think-tank-public-front-door",
  "main": "worker/frontdoor.mjs",
  "compatibility_date": "2026-10-16",
  "services": [
    {
      "binding": "APP",
      "service": "think-tank",
      "environment": "production"
    }
  ],
  "preview_urls": false,
  "workers_dev": false,
  "ratelimits": [
    {
      "name": "AUTH_ENTRY_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
